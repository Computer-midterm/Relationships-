# Required: your Anthropic API key (server-side only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Optional: model and effort for the coach (defaults shown)
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium

# Optional: per-IP rate limits (defaults shown)
# RATE_LIMIT_PER_10_MIN=20
# RATE_LIMIT_PER_DAY=150

# Development only: stream canned replies instead of calling the API
# COACH_MOCK=1
